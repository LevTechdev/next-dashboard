# Web Push VAPID Keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Stripe
STRIPE_SECRET_KEY=

# Midtrans
MIDTRANS_SERVER_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=

# Transactional email — SMTP or Resend (SMTP wins when SMTP_HOST is set)
# EMAIL_TRANSPORT: "auto" (default: SMTP when SMTP_HOST is set, else Resend),
#                  "smtp", or "resend".
EMAIL_TRANSPORT=auto
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# The From address users will see. Resend rejects sends from a domain you have
# not verified, and its sandbox sender (onboarding@resend.dev) delivers ONLY to
# the Resend account owner — every other recipient is dropped while the app
# reports success. Verify a domain in Resend and put it here.
EMAIL_FROM=
RESEND_API_KEY=
# Optional: a Resend-specific sender that overrides EMAIL_FROM for the Resend path.
RESEND_FROM=
