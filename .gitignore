# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# storybook
/storybook-static/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*

# Windows reserved names & embedded repos
/nul
/my-app/

# local verification / debug scripts and artifacts (never commit)
/verify-page.mjs
/verify-*.mjs
/verify-*.png
/verify-*.txt
/debug-*.mjs
/scripts/verify-*.mjs
/.ui-verify/
/.ui-verify*/

# accidentally-committed local junk (never re-commit)
/logfile
/server.log
/screenshot.png
/replace_api.js
/replace_hooks.js
/test-results.json

# local verification / audit screenshots (never commit)
/test-results/icon-check*/
/test-results/visual-qa-*/
scripts/dev-idp/
.next-prod/
