# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# storybook
/storybook-static/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*
# The template is not a secret — it is how a fresh clone learns which env vars
# exist (it is ignored above by `.env*`, which is why the mail keys went missing).
!.env.example

# Windows reserved names & embedded repos
/nul
/my-app/

# local verification / debug scripts and artifacts (never commit)
/verify-page.mjs
/verify-*.mjs
/verify-*.png
/verify-*.txt
/debug-*.mjs
/scripts/verify-*.mjs
/.ui-verify/
/.ui-verify*/

# accidentally-committed local junk (never re-commit)
/logfile
/server.log
/screenshot.png
/replace_api.js
/replace_hooks.js
/test-results.json

# dev-server stdout/stderr dumps captured while probing ports (never commit)
/server-out.txt
/server-p4.txt
/dev-*.log
dev-live.log

# Playwright artifacts (generated on every run — never commit)
/playwright-report/
/test-results/

# file-backed runtime ledgers: local state the app rewrites at runtime, so a
# commit would just be whichever dev session ran last (never commit)
/data/auto-payout-cycle.json
/data/auto-payouts.json
/data/auto-reorder-ledger.json
/data/inventory-snapshots.json
/data/leaf-sync-watermark.json
/data/leaf-sync-orphans-ack.json
/data/qris-ledger.json
/data/qris-ledger.json.bak
/data/report-schedule.json
/data/scheduler-runs.json

scripts/dev-idp/
supabase/.temp/
.next-prod/
.next-e2e/
.next-live/
.next-dev-live/
.freebuff/
.qa/
