#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# Env policy: local env files must point DATABASE_URL at the local Postgres
# mirror — a leaked remote Supabase URL silently splits the app (website vs
# scripts) across two databases.
node scripts/check-env-policy.mjs || exit 1

# Detect if TypeScript/JavaScript files are staged
STAGED_TS=$(git diff --cached --name-only --diff-filter=ACM | grep -cE '\.(ts|tsx)$' || true)

# ── SKIP_ESLINT mode: format + typecheck only, no eslint ──────────────────────
if [ -n "$SKIP_ESLINT" ]; then
  echo "🔶 SKIP_ESLINT=1 — running prettier + typecheck, skipping eslint"
  STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)
  # One file per read (not a space-split expansion) so paths with spaces or
  # parentheses survive.
  printf '%s\n' "$STAGED_FILES" | while IFS= read -r f; do
    if [ -n "$f" ]; then
      npx prettier --write --ignore-unknown "$f" || exit 1
    fi
  done || exit 1
  # Re-stage what prettier rewrote. Without this the commit captures the
  # pre-format bytes while the working tree keeps the formatted ones, so the
  # file shows as modified again the moment the commit lands (lint-staged does
  # this re-stage for you on the full-pipeline path below).
  printf '%s\n' "$STAGED_FILES" | while IFS= read -r f; do
    if [ -n "$f" ]; then
      git add -- "$f" || exit 1
    fi
  done || exit 1
  if [ "$STAGED_TS" -gt 0 ]; then
    echo "🔶 Running typecheck..."
    npx tsc --noEmit || exit $?
  fi
  exit 0
fi

# ── Full pipeline: lint-staged (eslint + prettier) + typecheck ────────────────
npx lint-staged

if [ "$STAGED_TS" -gt 0 ]; then
  npx tsc --noEmit
fi
