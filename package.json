{
  "name": "next-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3010",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "npx prisma generate",
    "db:push": "npx prisma db push",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:studio": "npx prisma studio",
    "prepare": "husky",
    "postinstall": "npx prisma generate",
    "railway:build": "npx prisma generate && npx next build",
    "railway:start": "npx prisma migrate deploy && node .next/standalone/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:components": "vitest run --config vitest.components.config.ts",
    "test:api": "vitest run --config vitest.api.config.ts",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:components && npm run test:api",
    "coverage:all": "npm run test -- --coverage && npm run test:components -- --coverage && npm run test:api -- --coverage && node scripts/merge-coverage.js",
    "coverage:merge": "node scripts/merge-coverage.js",
    "doctor": "npx react-doctor@latest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.16",
    "@ai-sdk/react": "^4.0.34",
    "@hookform/resolvers": "^4.1.0",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-avatar": "^1.1.4",
    "@radix-ui/react-checkbox": "^1.2.0",
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-dropdown-menu": "^2.1.7",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.3",
    "@radix-ui/react-popover": "^1.1.7",
    "@radix-ui/react-scroll-area": "^1.2.4",
    "@radix-ui/react-select": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.3",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.4",
    "@radix-ui/react-tabs": "^1.1.4",
    "@radix-ui/react-toast": "^1.2.7",
    "@radix-ui/react-tooltip": "^1.2.0",
    "@types/qrcode": "^1.5.6",
    "ai": "^7.0.31",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.42.2",
    "fuse.js": "^7.5.0",
    "ignore": "^7.0.6",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.475.0",
    "motion": "^12.42.2",
    "next": "16.2.9",
    "next-intl": "^4.0.0",
    "next-themes": "^0.4.6",
    "openai": "^6.48.0",
    "otplib": "^13.4.1",
    "posthog-js": "^1.398.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.54.0",
    "recharts": "^2.15.0",
    "sonner": "^2.0.1",
    "tailwind-merge": "^3.0.0",
    "three": "^0.185.1",
    "tree-sitter-c-sharp": "^0.23.5",
    "tree-sitter-cpp": "^0.23.4",
    "xlsx": "^0.18.5",
    "zod": "^3.24.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ],
    "*.{mjs,js,jsx}": [
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@playwright/test": "^1.61.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.9",
    "@storybook/addon-a11y": "^10.5.3",
    "@storybook/addon-docs": "^10.5.3",
    "@storybook/addon-mcp": "^0.7.0",
    "@storybook/addon-vitest": "^10.5.3",
    "@storybook/nextjs-vite": "^10.5.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.2",
    "conventional-changelog-conventionalcommits": "^10.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "eslint-plugin-storybook": "^10.5.3",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.1.1",
    "playwright": "^1.61.1",
    "postcss": "^8.5.16",
    "prisma": "^6.19.3",
    "react-doctor": "^0.7.2",
    "semantic-release": "^25.0.8",
    "storybook": "^10.5.3",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.0",
    "typescript": "^5",
    "vite": "^8.1.5",
    "vitest": "^4.1.9"
  }
}
