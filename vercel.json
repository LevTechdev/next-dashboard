{
  "framework": "nextjs",
  "buildCommand": "npx prisma migrate deploy && npx prisma generate && npx next build",
  "regions": ["sin1"],
  "crons": [
    {
      "path": "/api/usage/digest?secret=${CRON_SECRET}",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/billing/trial/sweep?secret=${CRON_SECRET}",
      "schedule": "15 2 * * *"
    }
  ]
}
